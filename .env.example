APP_ENV=development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
# Railway asigna PORT; el arranque usa PORT cuando existe.
FLASK_APP=wsgi:app
SECRET_KEY=change_me
JWT_SECRET_KEY=change_me
JWT_COOKIE_SECURE=false
# SameSite=Strict por defecto. En Railway (frontend y API en sitios distintos) use None.
JWT_COOKIE_SAMESITE=Strict
# Doble envío activo: el backend valida X-CSRF-TOKEN en refrescar y logout.
JWT_COOKIE_CSRF_PROTECT=true
MYSQL_DATABASE=unique
MYSQL_USER=unique_app
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me
MYSQL_HOST=mysql
MYSQL_PORT=3306
# Si cambia MYSQL_PASSWORD, actualice tambien la contrasena en DATABASE_URL y TEST_DATABASE_URL.
# Railway puede entregar mysql://...; la app lo normaliza a mysql+pymysql://...
DATABASE_URL=mysql+pymysql://unique_app:change_me@mysql:3306/unique?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://unique_app:change_me@mysql:3306/unique?charset=utf8mb4
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
TZ=America/Mexico_City
# Puertos publicados en el host; los puertos internos son 80, 8000 y 3306.
# Los valores por defecto (8080, 8000, 3306) pueden estar ocupados por otros proyectos.
PHPMYADMIN_PORT=8081
API_HOST_PORT=8001
MYSQL_HOST_PORT=3307
# Un worker mantiene el rate limit en memoria compartido dentro del proceso.
# Si aumenta este valor, configure RATELIMIT_STORAGE_URI con un almacén compartido.
WEB_CONCURRENCY=1
# Para escalar a más de una réplica use Redis (Flask-Limiter no soporta MySQL como almacén):
# RATELIMIT_STORAGE_URI=redis://<host>:6379/0
DB_WAIT_TIMEOUT=60

# Usuarios iniciales. Déjelos vacíos para omitir su creación.
# Defina contraseñas largas y únicas; nunca use los valores de ejemplo en producción.
ADMIN_EMAIL=
ADMIN_PASSWORD=
OPERATIVO_EMAIL=
OPERATIVO_PASSWORD=
